folders:
  timeout:
    authorized_keys:
      test_bootstrap_authorized_keys: 45
    cloud_azure:
      test_managed_identity: 60
      test_ip_family: 45
      test_expose_app_azure: 60
    controllercharm:
      test_prometheus: 60
    network:
      test_network_health: 45
    secrets_iaas:
      test_secrets_vault: 60
    model:
      test_model_migration: 90
      test_model_migration_abort: 90
      test_model_migration_saas_common: 90
      test_model_migration_saas_external: 90
      test_model_migration_caas: 90
      test_model_migration_version: 50
    deploy:
      test_deploy_bundles: 50
      test_deploy_charms: 50
    kubeflow:
      test_deploy_kubeflow: 50
    cloud_gce:
      test_serviceaccount_credential: 60
    coslite:
      test_deploy_coslite: 45
  ephemeral:
    - sidecar
    - smoke-aws
  cross-cloud:
    - controllercharm-lxd
  skip-all:
    - examples
    - ovs_maas
    - static_analysis
    - ck
  lxd:
    - '*_lxd'
    - actions
    - agents
    - appdata
    - authorized_keys
    - backup
    - bootstrap
    - branches
    - charmhub
    - cli
    - cmr
    - constraints
    - controller
    - controllercharm
    - credential
    - dashboard
    - deploy
    - hooks
    - hooktools
    - machine
    - manual
    - model
    - model_multi
    - network
    - refresh
    - relations
    - resources
    - secrets_iaas
    - smoke
    - ssh
    - unit
    - unmanaged
    - upgrade
    - upgrade_series
    - user
  aws:
    - '*_aws'
    - '*_ec2'
    - actions
    - agents
    - appdata
    - authorized_keys
    - backup
    - branches
    - charmhub
    - cmr
    - controller
    - credential
    - dashboard
    - deploy
    - firewall
    - hooks
    - hooktools
    - machine
    - manual
    - migration
    - model
    - model_multi
    - network
    - refresh
    - relations
    - resources
    - smoke
    - spaces_ec2
    - ssh
    - storage
    - unit
    - unmanaged
    - user
  google:
    - '*_gcp'
    - '*_gce'
    - actions
    - authorized_keys
    - constraints
    - controller
    - model
    - network
  azure:
    - '*_azure'
    - actions
    - authorized_keys
    - cloud_azure
    - deploy_aks
    - network
  microk8s:
    - '*_microk8s'
    - '*_k8s'
    - caasadmission
    - controllercharm
    - coslite
    - deploy_caas
    - kubeflow
    - migration
    - sidecar
    - smoke_k8s_psql
    - ssh
  exclude-tasks:
    lxd:
      - controller-test_limit_access
    google:
      - controller-test_metrics
      - controller-test_query_tracing
    azure:
      - controller-test_limit_access
    # The migration suite is split across providers: the juju 3.6
    # migration tasks gate on lxd/ec2 in tests/suites/migration, the
    # CMR secrets tasks gate on k8s. Keep the matrix aligned with
    # those gates so no job is generated that can only ever skip.
    microk8s:
      - migration-test_migration_36
      - migration-test_migration_36_abort
      - migration-test_migration_36_cmr_offering
      - migration-test_migration_36_cmr_consuming
      - migration-test_migration_36_cmr_spaces
      - migration-test_migration_36_users_permissions
      - migration-test_migration_36_relation_egress_override
      - migration-test_migration_36_image_metadata
      - migration-test_migration_abort
      - migration-test_migration_basic
      - migration-test_migration_saas_common
      - migration-test_migration_saas_consumer
      - migration-test_migration_saas_external
      - migration-test_migration_version
    aws:
      - migration-test_migration_36_cmr_secrets_consumer
      - migration-test_migration_36_cmr_secrets_offerer
  skip-subtasks:
    - test_pebble_change_updated
    - test_upgrade_simplestream_previous
    - test_build
